LLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
# 4-bit keeps the model (~3 GB) entirely on a 6 GB GPU; set 0 on a larger card for full bf16.
LLM_4BIT=1
# cpu leaves the GPU to the LLM; set cuda if you have spare VRAM.
SPEECH_DEVICE=cpu

# IndicF5 clones the voice of a short reference clip (5-10 s WAV) and needs its exact transcript.
INDICF5_REF_AUDIO=prompts/reference.wav
INDICF5_REF_TEXT=
