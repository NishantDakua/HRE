// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  clerkUserId   String?    @unique
  email         String     @unique
  password      String?
  firstName     String?
  lastName      String?
  phoneNumber   String?
  role          UserRole   @default(ADMIN)
  hreRole       HRERole    @default(SEEKER)
  businessId    String?
  business      Business?  @relation("UserBusiness", fields: [businessId], references: [id])
  onboardingComplete Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  notifications Notification[]
  messages      Message[]
  sentMessages  Message[]  @relation("MessageSender")
}

enum UserRole {
  ADMIN
  USER
}

enum HRERole {
  SEEKER
  PROVIDER
  BOTH
}

model Business {
  id                     String     @id @default(cuid())
  name                   String
  businessType           String
  location               String
  registrationNumber     String?
  gstNumber              String?
  uDYAMNumber            String?
  cinNumber              String?
  logoUrl                String?
  coverImageUrl          String?
  description            String?
  contactEmail           String
  contactPhone           String
  website                String?
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  verificationProvider   String?
  verifiedAt             DateTime?
  verificationReference  String?
  businessCategory       String?
  yearsInBusiness        Int?
  employees              Int?
  areaOfOperation        String?
  users                  User[]     @relation("UserBusiness")
  providerProfile        ProviderProfile?
  resources              Resource[]
  inventory              Inventory[]
  requirements           Requirement[]
  incomingNegotiations   Negotiation[] @relation("NegotiationProvider")
  buyerNegotiations      Negotiation[] @relation("NegotiationBuyer")
  providerBookingItems   BookingItem[] @relation("BookingItemProvider")
  buyerBookings          Booking[]  @relation("BookingBuyer")
  reviews                Review[]   @relation("ReviewedBusiness")
  reviewsGiven           Review[]   @relation("ReviewAuthor")
  payments               Payment[]
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model ProviderProfile {
  id                    String     @id @default(cuid())
  businessId            String     @unique
  business              Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  averageRating         Float      @default(0)
  totalReviews          Int        @default(0)
  responseTime          Int        @default(24)
  fulfillmentRate       Float      @default(0)
  completedTransactions Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  icon        String
  description String?
  resources   Resource[]
  requirements Requirement[]
  createdAt   DateTime   @default(now())
}

model Resource {
  id                  String     @id @default(cuid())
  businessId          String
  business            Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category   @relation(fields: [categoryId], references: [id])
  name                String
  description         String
  specifications      String?
  quantity            Int
  price               Float
  unit                String
  location            String
  serviceArea         String?
  minQuantity         Int        @default(1)
  availability        String     @default("AVAILABLE")
  terms               String?
  images              ResourceImage[]
  inventory           Inventory[]
  requirementItems    RequirementItem[]
  matchItems          MatchItem[]
  bookingItems        BookingItem[]
  reviews             Review[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([businessId])
  @@index([categoryId])
}

model ResourceImage {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  imageUrl   String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Inventory {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reserved    Int      @default(0)
  available   Int
  lastUpdated DateTime @updatedAt

  @@unique([businessId, resourceId])
}

model Requirement {
  id              String     @id @default(cuid())
  buyerId         String
  buyer           Business   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category   @relation(fields: [categoryId], references: [id])
  title           String
  description     String
  location        String
  requiredDate    DateTime
  budgetMin       Float?
  budgetMax       Float?
  status          RequirementStatus @default(POSTED)
  items           RequirementItem[]
  matches         Match[]
  negotiations    Negotiation[]
  bookings        Booking[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([buyerId])
  @@index([categoryId])
}

enum RequirementStatus {
  POSTED
  MATCHING
  MATCHED
  BOOKED
  COMPLETED
  CANCELLED
}

model RequirementItem {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      Resource    @relation(fields: [resourceId], references: [id])
  quantity      Int
  createdAt     DateTime    @default(now())

  @@index([requirementId])
}

model Match {
  id              String     @id @default(cuid())
  requirementId   String
  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status          MatchStatus @default(ACTIVE)
  totalQuantity   Int
  requiredQuantity Int
  items           MatchItem[]
  confidence      Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([requirementId])
}

enum MatchStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  COMPLETED
}

model MatchItem {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  providerId String
  quantity   Int
  price      Float
  createdAt  DateTime @default(now())

  @@index([matchId])
}

model Negotiation {
  id              String     @id @default(cuid())
  requirementId   String
  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  providerId      String
  provider        Business   @relation("NegotiationProvider", fields: [providerId], references: [id])
  buyerId         String
  buyer           Business   @relation("NegotiationBuyer", fields: [buyerId], references: [id])
  status          NegotiationStatus @default(PENDING)
  quantity        Int
  currentPrice    Float
  offeredPrice    Float?
  messages        NegotiationMessage[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([requirementId])
  @@index([providerId])
  @@index([buyerId])
}

enum NegotiationStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}

model NegotiationMessage {
  id            String      @id @default(cuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  senderId      String
  message       String
  messageType   String      @default("TEXT")
  createdAt     DateTime    @default(now())

  @@index([negotiationId])
}

model Booking {
  id          String       @id @default(cuid())
  buyerId     String
  buyer       Business     @relation("BookingBuyer", fields: [buyerId], references: [id])
  requirementId String
  requirement Requirement  @relation(fields: [requirementId], references: [id])
  status      BookingStatus @default(CONFIRMED)
  totalAmount Float
  items       BookingItem[]
  fulfillment Fulfillment?
  payment     Payment?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([buyerId])
  @@index([requirementId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model BookingItem {
  id                  String   @id @default(cuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerId          String
  provider            Business @relation("BookingItemProvider", fields: [providerId], references: [id])
  resourceId          String
  resource            Resource @relation(fields: [resourceId], references: [id])
  quantity            Int
  agreedPrice         Float
  subtotal            Float
  fulfillmentStatus   FulfillmentStatus @default(BOOKED)
  paymentStatus       PaymentStatus @default(PENDING)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([bookingId])
  @@index([providerId])
}

enum FulfillmentStatus {
  BOOKED
  PREPARING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CONFIRMED
}

enum PaymentStatus {
  PENDING
  SECURED
  DELIVERING
  RELEASED
  FAILED
}

model Fulfillment {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String   @default("IN_PROGRESS")
  timeline  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  amount      Float
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient User     @relation(fields: [recipientId], references: [id])
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  author      Business @relation("ReviewAuthor", fields: [authorId], references: [id])
  businessId  String
  business    Business @relation("ReviewedBusiness", fields: [businessId], references: [id])
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id])
  rating      Float
  comment     String?
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@index([resourceId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  business  String?
  email     String
  phone     String?
  subject   String
  message   String
  category  String   @default("general")
  createdAt DateTime @default(now())
}

// Spare exchange — shape matches the Abhishek frontend API.

model ExchangeBusiness {
  id              String   @id
  name            String
  type            String
  area            String
  address         String
  lat             Float
  lng             Float
  rating          Float
  reviewCount     Int
  responseRate    Float
  avgResponseMins Int
  fulfillmentRate Float
  verified        Boolean
  joinedAt        DateTime
  clerkUserId     String?  @unique
  ownerEmail      String?
  listings        ExchangeListing[]
  seekerBookings  ExchangeBooking[] @relation("SeekerBookings")
}

model ExchangeListing {
  id             String   @id
  businessId     String
  business       ExchangeBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title          String
  category       String
  description    String
  price          Float
  unit           String
  quantity       Int
  available      Int
  unitLabel      String
  minRentalHours Int
  capacity       Int?
  tags           String[]
  delivers       Boolean
  deliveryBase   Float?
  deliveryPerKm  Float?
  status         String   @default("ACTIVE")
  conditions     String[]
  cancellation   String?
  deposit        Float?
  photos         ExchangeListingPhoto[]
  units          ExchangeUnit[]
  items          ExchangeBookingItem[]

  @@index([businessId])
  @@index([category])
}

model ExchangeListingPhoto {
  id        String          @id @default(cuid())
  listingId String
  listing   ExchangeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position  String
  url       String

  @@unique([listingId, position])
  @@index([listingId])
}

model ExchangeBooking {
  id        String   @id
  ref       String   @unique
  seekerId  String
  seeker    ExchangeBusiness @relation("SeekerBookings", fields: [seekerId], references: [id])
  title     String
  status    String
  startAt   DateTime
  endAt     DateTime
  total     Float
  urgent    Boolean  @default(false)
  note      String?
  createdAt DateTime
  items     ExchangeBookingItem[]
  offers    ExchangeOffer[]
  reviews   ExchangeReview[]
  contracts ExchangeContract[]

  @@index([seekerId])
  @@index([status])
}

model ExchangeBookingItem {
  id          String          @id @default(cuid())
  bookingId   String
  booking     ExchangeBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    ExchangeListing @relation(fields: [resourceId], references: [id])
  providerId  String
  quantity    Int
  agreedPrice Float

  @@index([bookingId])
  @@index([providerId])
  @@index([resourceId])
}

model ExchangeOffer {
  id             String          @id
  bookingId      String
  booking        ExchangeBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceId     String
  fromBusinessId String
  toBusinessId   String
  round          Int
  price          Float
  quantity       Int
  message        String
  status         String
  createdAt      DateTime
  expiresAt      DateTime

  @@index([bookingId])
}

model ExchangeContract {
  id         String   @id @default(cuid())
  bookingId  String
  booking    ExchangeBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerId String
  seekerId   String
  lines      Json
  terms      String[]
  cancellation String?
  rentTotal          Float
  deposit            Float
  arrivedAt          DateTime?
  returnedAt         DateTime?
  seekerApprovedAt   DateTime?
  providerApprovedAt DateTime?
  createdAt          DateTime @default(now())
  signatures ExchangeContractSignature[]
  scans      ExchangeContractScan[]
  disputes   ExchangeDispute[]
  unitPhotos ExchangeHandoverPhoto[]

  @@unique([bookingId, providerId])
  @@index([seekerId])
  @@index([providerId])
}

model ExchangeUnit {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  listingId String
  listing   ExchangeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status    String   @default("IN_STOCK")
  createdAt DateTime @default(now())
  reads     ExchangeUnitRead[]

  @@unique([listingId, label])
  @@index([listingId])
  @@index([status])
}

model ExchangeHandoverPhoto {
  id         String   @id @default(cuid())
  contractId String
  contract   ExchangeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  phase      String
  kind       String   @default("LABEL")
  imageUrl   String
  createdAt  DateTime @default(now())
  reads      ExchangeUnitRead[]

  @@index([contractId])
}

model ExchangeUnitRead {
  id         String   @id @default(cuid())
  unitId     String
  unit       ExchangeUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  photoId    String
  photo      ExchangeHandoverPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  contractId String
  phase      String
  createdAt  DateTime @default(now())

  @@unique([unitId, contractId, phase])
  @@index([contractId, phase])
}

model ExchangeContractSignature {
  id         String   @id @default(cuid())
  contractId String
  contract   ExchangeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  role       String
  purpose    String
  imageUrl   String
  signedAt   DateTime @default(now())

  @@unique([contractId, purpose])
}

model ExchangeContractScan {
  id         String   @id @default(cuid())
  contractId String
  contract   ExchangeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  businessId String
  role       String
  phase      String   @default("RECEIPT")
  scannedAt  DateTime @default(now())

  @@index([contractId])
}

model ExchangeDispute {
  id                String   @id @default(cuid())
  contractId        String
  contract          ExchangeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedById        String
  phase             String   @default("RECEIPT")
  nature            String   @default("")
  fault             String
  reason            String
  note              String   @default("")
  receivedQuantity  Int?
  damagedQuantity   Int?
  severity          String?
  status            String   @default("OPEN")
  seekerAgreed      Boolean  @default(false)
  providerAgreed    Boolean  @default(false)
  rentDue           Float
  damageDue         Float
  refund            Float
  createdAt         DateTime @default(now())

  @@index([contractId])
}

model ExchangeReview {
  id           String          @id @default(cuid())
  bookingId    String
  booking      ExchangeBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  byBusinessId String
  rating       Int
  text         String
  tags         String[]
  createdAt    DateTime
}

model ExchangeNotification {
  id         String   @id
  businessId String?
  title      String
  body       String
  createdAt  DateTime
  read       Boolean  @default(false)

  @@index([businessId])
}

model ExchangeSavedSearch {
  id         String   @id
  businessId String?
  name       String
  query      String
  createdAt  DateTime
  newMatches Int

  @@index([businessId])
}
