{
  "name": "hre",
  "version": "1.0.0",
  "description": "HRE - Hospitality Resource Exchange B2B Marketplace",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter hre-client dev\" \"pnpm --filter hre-server dev\"",
    "dev:client": "pnpm --filter hre-client dev",
    "dev:server": "pnpm --filter hre-server dev",
    "build": "pnpm --filter hre-client build && pnpm --filter hre-server build",
    "build:client": "pnpm --filter hre-client build",
    "build:server": "pnpm --filter hre-server build",
    "preview": "pnpm --filter hre-client preview",
    "type-check": "pnpm --filter hre-client type-check && pnpm --filter hre-server type-check",
    "db:generate": "pnpm --filter hre-server prisma:generate",
    "db:push": "pnpm --filter hre-server prisma:push",
    "db:seed": "pnpm --filter hre-server prisma:seed",
    "db:studio": "pnpm --filter hre-server prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
