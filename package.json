{
  "name": "hre",
  "version": "1.0.0",
  "description": "HRE - Hospitality Resource Exchange B2B Marketplace",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter hre-client --filter hre-server dev",
    "dev:client": "pnpm --filter hre-client dev",
    "dev:server": "pnpm --filter hre-server dev",
    "build": "pnpm --filter hre-client build && pnpm --filter hre-server build",
    "build:client": "pnpm --filter hre-client build",
    "build:server": "pnpm --filter hre-server build",
    "preview": "pnpm --filter hre-client preview",
    "type-check": "pnpm -r type-check",
    "db:generate": "pnpm --filter hre-server prisma:generate",
    "db:push": "pnpm --filter hre-server prisma:push",
    "db:seed": "pnpm --filter hre-server prisma:seed",
    "db:migrate": "pnpm --filter hre-server prisma:migrate",
    "db:constraints": "pnpm --filter hre-server db:constraints",
    "db:backup": "pnpm --filter hre-server db:backup",
    "demo:users": "pnpm --filter hre-server demo:users",
    "demo:data": "pnpm --filter hre-server demo:data"
  },
  "pnpm": {
    "overrides": {
      "three": "0.169.0",
      "@types/three": "0.169.0"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "server": "^1.0.42"
  }
}
